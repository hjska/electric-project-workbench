# ---- 依赖 ----
node_modules/

# ---- 构建产物（由 npm run build / npm run dist 生成）----
dist/
dist-electron/
dist-exe/
release/
release*/

# ---- 本地运行数据（数据库、附件、工程资料文件夹）----
data/
data-test/
data-demo/

# ---- 本地工作记录（WorkBuddy 会话记忆，含本机路径等信息）----
.workbuddy/

# ---- 运行截图（本地产物；README 展示用的图放在 docs/images/）----
screenshots/

# ---- 日志与系统临时文件 ----
*.log
debug.log
Thumbs.db
.DS_Store
*.tmp

# ---- 测试沙箱残留 ----
probe-*/
verify-data/
