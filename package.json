{
  "name": "electric-project-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "电气项目管理台 —— 面向电气安装工程的单机项目管理桌面应用：项目台账 / 设备物料 / 施工进度与甘特图 / 问题闭环 / 工程资料文件夹，数据全部本地存储。",
  "author": "hjska <ajthx@foxmail.com>",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "build:renderer": "vite build",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:e2e": "node scripts/e2e-verify.cjs",
    "verify:pkg": "node scripts/pkg-verify.cjs",
    "make:launcher": "node scripts/make-launchers.cjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "antd": "^5.21.6",
    "better-sqlite3": "^11.5.0",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.8.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
